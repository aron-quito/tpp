// --- MATEMÁTICA AUXILIAR ---
fun modulo(entero n) -> entero {
    mientras (n < 0) {
        n = n + 26;
    }
    retornar n % 26;
}

// --- PANEL DE CLAVIJAS (BQ CR DI EJ KW MT OS PX UZ GH) ---
fun clavijas(entero l) -> entero {
    depende l {
        1: retornar 16;  16: retornar 1;
        2: retornar 17;  17: retornar 2;
        3: retornar 8;   8: retornar 3;
        4: retornar 9;   9: retornar 4;
        10: retornar 22; 22: retornar 10;
        12: retornar 19; 19: retornar 12;
        14: retornar 18; 18: retornar 14;
        15: retornar 23; 23: retornar 15;
        20: retornar 25; 25: retornar 20;
        6: retornar 7;   7: retornar 6;
        otros: retornar l;
    }
}

// --- REFLECTOR B ---
fun reflectorB(entero l) -> entero {
    depende l {
        0: retornar 24; 1: retornar 17; 2: retornar 20; 3: retornar 7;
        4: retornar 16; 5: retornar 18; 6: retornar 11; 7: retornar 3;
        8: retornar 15; 9: retornar 23; 10: retornar 13; 11: retornar 6;
        12: retornar 14; 13: retornar 10; 14: retornar 12; 15: retornar 8;
        16: retornar 4; 17: retornar 1; 18: retornar 5; 19: retornar 25;
        20: retornar 2; 21: retornar 22; 22: retornar 21; 23: retornar 9;
        24: retornar 0; 25: retornar 19;
        otros: retornar l;
    }
}

// --- ROTOR I ---
fun rotorUnoFwd(entero l) -> entero {
    depende l {
        0: retornar 4; 1: retornar 10; 2: retornar 12; 3: retornar 5;
        4: retornar 11; 5: retornar 6; 6: retornar 3; 7: retornar 16;
        8: retornar 21; 9: retornar 25; 10: retornar 13; 11: retornar 19;
        12: retornar 14; 13: retornar 22; 14: retornar 24; 15: retornar 7;
        16: retornar 23; 17: retornar 20; 18: retornar 18; 19: retornar 15;
        20: retornar 0; 21: retornar 8; 22: retornar 1; 23: retornar 17;
        24: retornar 2; 25: retornar 9; otros: retornar l;
    }
}
fun rotorUnoRev(entero l) -> entero {
    depende l {
        4: retornar 0; 10: retornar 1; 12: retornar 2; 5: retornar 3;
        11: retornar 4; 6: retornar 5; 3: retornar 6; 16: retornar 7;
        21: retornar 8; 25: retornar 9; 13: retornar 10; 19: retornar 11;
        14: retornar 12; 22: retornar 13; 24: retornar 14; 7: retornar 15;
        23: retornar 16; 20: retornar 17; 18: retornar 18; 15: retornar 19;
        0: retornar 20; 8: retornar 21; 1: retornar 22; 17: retornar 23;
        2: retornar 24; 9: retornar 25; otros: retornar l;
    }
}

// --- ROTOR II ---
fun rotorDosFwd(entero l) -> entero {
    depende l {
        0: retornar 0; 1: retornar 9; 2: retornar 3; 3: retornar 10;
        4: retornar 18; 5: retornar 8; 6: retornar 17; 7: retornar 20;
        8: retornar 23; 9: retornar 1; 10: retornar 11; 11: retornar 7;
        12: retornar 22; 13: retornar 19; 14: retornar 12; 15: retornar 2;
        16: retornar 16; 17: retornar 6; 18: retornar 25; 19: retornar 13;
        20: retornar 15; 21: retornar 24; 22: retornar 5; 23: retornar 21;
        24: retornar 14; 25: retornar 4; otros: retornar l;
    }
}
fun rotorDosRev(entero l) -> entero {
    depende l {
        0: retornar 0; 9: retornar 1; 3: retornar 2; 10: retornar 3;
        18: retornar 4; 8: retornar 5; 17: retornar 6; 20: retornar 7;
        23: retornar 8; 1: retornar 9; 11: retornar 10; 7: retornar 11;
        22: retornar 12; 19: retornar 13; 12: retornar 14; 2: retornar 15;
        16: retornar 16; 6: retornar 17; 25: retornar 18; 13: retornar 19;
        15: retornar 20; 24: retornar 21; 5: retornar 22; 21: retornar 23;
        14: retornar 24; 4: retornar 25; otros: retornar l;
    }
}

// --- ROTOR III ---
fun rotorTresFwd(entero l) -> entero {
    depende l {
        0: retornar 1; 1: retornar 3; 2: retornar 5; 3: retornar 7;
        4: retornar 9; 5: retornar 11; 6: retornar 2; 7: retornar 15;
        8: retornar 17; 9: retornar 19; 10: retornar 23; 11: retornar 21;
        12: retornar 25; 13: retornar 13; 14: retornar 24; 15: retornar 4;
        16: retornar 8; 17: retornar 22; 18: retornar 6; 19: retornar 0;
        20: retornar 10; 21: retornar 12; 22: retornar 20; 23: retornar 18;
        24: retornar 16; 25: retornar 14; otros: retornar l;
    }
}
fun rotorTresRev(entero l) -> entero {
    depende l {
        1: retornar 0; 3: retornar 1; 5: retornar 2; 7: retornar 3;
        9: retornar 4; 11: retornar 5; 2: retornar 6; 15: retornar 7;
        17: retornar 8; 19: retornar 9; 23: retornar 10; 21: retornar 11;
        25: retornar 12; 13: retornar 13; 24: retornar 14; 4: retornar 15;
        8: retornar 16; 22: retornar 17; 6: retornar 18; 0: retornar 19;
        10: retornar 20; 12: retornar 21; 20: retornar 22; 18: retornar 23;
        16: retornar 24; 14: retornar 25; otros: retornar l;
    }
}

// --- LÓGICA DE PASO POR ROTOR ---
fun pasarRotor(entero letra, entero pos, entero anillo, entero numRotor, entero reverso) -> entero {
    entero desp, entrada, salida;
    desp = modulo(pos - anillo);
    entrada = modulo(letra + desp);
    salida = 0;
    
    si (numRotor == 1) {
        si (reverso == 0) { salida = rotorUnoFwd(entrada); } 
        sino { salida = rotorUnoRev(entrada); }
    }
    si (numRotor == 2) {
        si (reverso == 0) { salida = rotorDosFwd(entrada); } 
        sino { salida = rotorDosRev(entrada); }
    }
    si (numRotor == 3) {
        si (reverso == 0) { salida = rotorTresFwd(entrada); } 
        sino { salida = rotorTresRev(entrada); }
    }
    
    retornar modulo(salida - desp);
}

// --- FLUJO DEL MENSAJE Y CRIB ---
// PVRGDDYWGVESRMHFDKFHUEPBFIA
fun obtenerMensaje(entero i) -> entero {
    depende i {
        0: retornar 15; 1: retornar 21; 2: retornar 17; 3: retornar 6;
        4: retornar 3; 5: retornar 3; 6: retornar 24; 7: retornar 22;
        8: retornar 6; 9: retornar 21; 10: retornar 4; 11: retornar 18;
        12: retornar 17; 13: retornar 12; 14: retornar 7; 15: retornar 5;
        16: retornar 3; 17: retornar 10; 18: retornar 5; 19: retornar 7;
        20: retornar 20; 21: retornar 4; 22: retornar 15; 23: retornar 1;
        24: retornar 5; 25: retornar 8; 26: retornar 0;
        otros: retornar 0;
    }
}

// Buscar: "HEILXHITLER"
fun chequearCrib(entero letra, entero estadoActual) -> entero {
    depende estadoActual {
        0: si (letra == 7) { retornar 1; } sino { retornar 0; }
        1: si (letra == 4) { retornar 2; } sino { retornar 0; }
        2: si (letra == 8) { retornar 3; } sino { retornar 0; }
        3: si (letra == 11) { retornar 4; } sino { retornar 0; }
        4: si (letra == 23) { retornar 5; } sino { retornar 0; }
        5: si (letra == 7) { retornar 6; } sino { retornar 0; }
        6: si (letra == 8) { retornar 7; } sino { retornar 0; }
        7: si (letra == 19) { retornar 8; } sino { retornar 0; }
        8: si (letra == 11) { retornar 9; } sino { retornar 0; }
        9: si (letra == 4) { retornar 10; } sino { retornar 0; }
        10: si (letra == 17) { retornar 11; } sino { retornar 0; }
        otros: retornar 0;
    }
}

// =========================================================
// FUNCIÓN PRINCIPAL DE CRACKEO
// =========================================================

fun iniciarCrack() -> entero {
    entero posIzq, posMed, posDer;
    entero anilloIzq, anilloMed, anilloDer;
    entero pasoIzq, pasoMed;
    entero tmp;
    entero letraCifrada, letraClara;
    entero estadoCrib;
    entero longMsg;
    
    longMsg = 27;
    anilloIzq = 0; 
    anilloMed = 0; 
    anilloDer = 0;

    para (entero rA = 0; rA < 26; rA = rA + 1) {
        para (entero rB = 0; rB < 26; rB = rB + 1) {
            para (entero rC = 0; rC < 26; rC = rC + 1) {
                
                posIzq = rA;
                posMed = rB;
                posDer = rC;
                estadoCrib = 0;
                
                para (entero idx = 0; idx < longMsg; idx = idx + 1) {
                    letraCifrada = obtenerMensaje(idx);
                    
                    // --- GIRAR ROTORES ---
                    // Segun config diaria: II (Izq), I (Med, Muesca Q=16), III (Der, Muesca V=21)
                    pasoIzq = 0;
                    pasoMed = 0;
                    
                    si (posMed == 16) { pasoIzq = 1; }
                    si (posDer == 21) { pasoMed = 1; }

                    si (pasoMed == 1) {
                        posMed = modulo(posMed + 1);
                        posIzq = modulo(posIzq + 1);
                    } sino {
                        si (pasoIzq == 1) {
                            posMed = modulo(posMed + 1);
                            posIzq = modulo(posIzq + 1);
                        }
                    }
                    posDer = modulo(posDer + 1);
                    
                    // --- CIFRAR LETRA ---
                    tmp = clavijas(letraCifrada);
                    
                    // Viaje de ida (Derecha -> Izquierda)
                    tmp = pasarRotor(tmp, posDer, anilloDer, 3, 0); // Rotor III
                    tmp = pasarRotor(tmp, posMed, anilloMed, 1, 0); // Rotor I
                    tmp = pasarRotor(tmp, posIzq, anilloIzq, 2, 0); // Rotor II
                    
                    // Reflector
                    tmp = reflectorB(tmp);
                    
                    // Viaje de vuelta (Izquierda -> Derecha)
                    tmp = pasarRotor(tmp, posIzq, anilloIzq, 2, 1);
                    tmp = pasarRotor(tmp, posMed, anilloMed, 1, 1);
                    tmp = pasarRotor(tmp, posDer, anilloDer, 3, 1);
                    
                    letraClara = clavijas(tmp);
                    
                    // --- VERIFICAR CRIB ---
                    estadoCrib = chequearCrib(letraClara, estadoCrib);
                    
                    si (estadoCrib == 11) {
                        // Encontramos la configuración correcta
                        imprimir(rA);
                        imprimir(rB);
                        imprimir(rC);
                        retornar 1;
                    }
                }
            }
        }
    }
    
    retornar 0;
}