// Test: Array global modificado desde funciones + para (for) loop

entero arr[5];

arr[0] = 10;
arr[1] = 20;
arr[2] = 30;
arr[3] = 40;
arr[4] = 50;

fun main() {
    imprimir("Array original:");
    para(entero j = 0; j < 5; j = j + 1) {
        imprimir(arr[j]);
    }

    para(entero i = 0; i < 5; i = i + 1) {
        arr[i] = arr[i] + 5;
    }

    imprimir("Array luego de sumar 5:");
    para(entero j = 0; j < 5; j = j + 1) {
        imprimir(arr[j]);
    }
}