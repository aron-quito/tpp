entero cuenta;

imprimir("¿Desde que numero quieres iniciar la cuenta regresiva?: ");
leer(cuenta);

mientras (cuenta > 0) {
    imprimir("Segundos restantes: ", cuenta, "\n");
    cuenta = cuenta - 1;
}

imprimir("¡Tiempo cumplido!\n");

entero tabla;
imprimir("¿De que numero deseas ver la tabla de multiplicar?: ");
leer(tabla);

para (entero i = 1; i <= 10; i = i + 1) {
    entero resultado;
    resultado = tabla * i;
    imprimir(tabla, " x ", i, " = ", resultado, "\n");
}
