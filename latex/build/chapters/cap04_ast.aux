\newlabel{fig:ast_funcion}{{6.2}{37}{\textbf {AST generado por TPP} para \texttt {fun main()\{ entero resultado = 10*2; imprimir(resultado); \}}. Nodos azules = nodos internos con semántica; nodos verdes = hojas terminales (literales o identificadores)}{figure.6.2}{}}
